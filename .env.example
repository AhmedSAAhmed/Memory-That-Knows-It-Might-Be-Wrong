# Copy to .env for local runs. On Render, set these in the dashboard (never commit real keys).
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Models (defaults shown)
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
OPENROUTER_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Storage
DATABASE_PATH=data/memory.db

# Abuse limits for the public demo
MAX_MESSAGES_PER_SESSION_PER_HOUR=60
MAX_OUTPUT_TOKENS=900
