{
  "_doc": "Single home for every memory number. Read by app/config.py. Explained in memory-model.md.",
  "source_base_confidence": {
    "user_confirmed": 0.95,
    "user_stated": 0.9,
    "agent_record": 0.85,
    "crm_import": 0.8,
    "inferred": 0.55
  },
  "thresholds": {
    "assert": 0.75,
    "hedge": 0.4
  },
  "guard_threshold": 0.9,
  "evaluation": {"repetitions": 3, "live_scenarios": 6},
  "retrieval": {"limit": 6, "lexical_weight": 0.5, "embedding_weight": 0.5, "embedding_dimensions": 256},
  "demo": {"max_days": 365, "session_seconds": 28800, "max_sessions": 1000},
  "query_terms": {
    "location": ["city", "live", "location", "delivery", "address", "moved"],
    "language": ["language", "speak", "arabic", "english"],
    "contact_pref": ["contact", "phone", "whatsapp", "email"],
    "open_issue": ["issue", "ticket", "damaged", "sofa", "problem"],
    "commitment": ["promise", "refund", "commitment"],
    "preference": ["prefer", "preference", "like", "food", "diet", "vegetarian"]
  },
  "list_query_pattern": "(?i)\\b(?:remember|memories|about me)\\b",
  "confirmation_replies": ["yes", "yes please", "correct", "still correct", "that's right", "that is right", "نعم"],
  "limits": {"message_chars": 2000, "field_chars": 500, "key_chars": 80, "max_candidates": 12},
  "key_aliases": {
    "location": {"city": "delivery_city", "home_city": "delivery_city", "current_city": "delivery_city", "residence_city": "delivery_city", "living_city": "delivery_city", "address": "delivery_address", "home_address": "delivery_address"},
    "language": {"preferred_language": "language", "language_preference": "language"},
    "contact_pref": {"contact_method": "contact_preference", "preferred_contact": "contact_preference", "contact_pref": "contact_preference"}
  },
  "secret_patterns": [
    "(?i)\\b(?:password|passwd|cvv|otp|one.time.password|iban|passport|national.?id|card.number)\\b",
    "(?<!\\d)(?:\\d[ -]?){13,19}(?!\\d)",
    "(?i)\\bAE\\d{21}\\b",
    "(?i)\\b(?:sk-|gsk_)[a-z0-9_-]+"
  ],
  "instruction_patterns": ["(?i)\\b(?:ignore|override|disregard)\\b.{0,40}\\b(?:rules|instructions|system|policy)\\b", "(?i)\\b(?:reveal|show)\\b.{0,30}\\b(?:other users|system prompt|api keys)\\b"],
  "sensitive_patterns": {
    "health": "(?i)\\b(?:pregnan\\w*|diabet\\w*|diagnos\\w*|medication|medical|health|allerg\\w*)\\b",
    "finance": "(?i)\\b(?:salary|income|debt|bank balance|financial)\\b",
    "family": "(?i)\\b(?:spouse|husband|wife|children|my child|my son|my daughter)\\b"
  },
  "corroboration_boost": 0.05,
  "corroboration_cap": 0.98,
  "contested_penalty": 0.35,
  "stale_after_fraction_of_half_life": 1.0,
  "categories": {
    "identity":      {"half_life_days": 3650, "sensitivity": "normal"},
    "contact_pref":  {"half_life_days": 365,  "sensitivity": "normal"},
    "language":      {"half_life_days": 730,  "sensitivity": "normal"},
    "location":      {"half_life_days": 365,  "sensitivity": "normal"},
    "preference":    {"half_life_days": 180,  "sensitivity": "normal"},
    "product_owned": {"half_life_days": 365,  "sensitivity": "normal"},
    "open_issue":    {"half_life_days": 14,   "sensitivity": "normal"},
    "commitment":    {"half_life_days": 30,   "sensitivity": "normal"},
    "sentiment":     {"half_life_days": 2,    "sensitivity": "normal"},
    "health":        {"half_life_days": 90,   "sensitivity": "sensitive"},
    "finance":       {"half_life_days": 90,   "sensitivity": "sensitive"},
    "family":        {"half_life_days": 365,  "sensitivity": "sensitive"},
    "credential":    {"half_life_days": 0,    "sensitivity": "secret"}
  },
  "never_store_patterns": [
    "card_number", "cvv", "password", "otp", "iban", "national_id", "passport_number"
  ]
}
